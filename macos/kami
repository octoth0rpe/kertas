#!/bin/sh
# kami: open files in Kami from the terminal.
#
#   kami notes.md todo.md   # open (or switch to) these files
#   kami new-idea.md        # a file that doesn't exist yet: saving creates it
#   kami                    # bring Kami to the front
#
# This script lives inside Kami.app. Kami's settings install it as
# /usr/local/bin/kami, a link to this file, so it always opens the Kami.app
# it came from. It hands files to Kami as kami:// links, which reach a
# running Kami or launch it, and work for files that don't exist yet.
set -eu

# Kami.app is three levels up from Contents/Resources/kami.
script=$(realpath "$0")
app=$(dirname "$(dirname "$(dirname "$script")")")

# Percent-encodes $1 for a URL, byte by byte.
urlencode() {
    LC_ALL=C
    rest=$1
    out=
    while [ -n "$rest" ]; do
        c=${rest%"${rest#?}"}
        rest=${rest#?}
        case $c in
            [A-Za-z0-9._~/-]) out="$out$c" ;;
            *) out="$out$(printf '%%%02X' $(( $(printf '%d' "'$c") & 255 )))" ;;
        esac
    done
    printf '%s' "$out"
}

if [ $# -eq 0 ]; then
    exec "${KAMI_OPEN:-open}" -a "$app" "kami://activate"
fi

urls=
for path in "$@"; do
    case $path in
        /*) ;;
        *) path="$PWD/$path" ;;
    esac
    urls="$urls kami://open?path=$(urlencode "$path")"
done
# The URLs have no spaces after encoding, so splitting on spaces is safe.
# shellcheck disable=SC2086
exec "${KAMI_OPEN:-open}" -a "$app" $urls
