#!/bin/sh
# kt: open files in Kertas from the terminal.
#
#   kt notes.md todo.md   # open (or switch to) these files
#   kt new-idea.md        # a file that doesn't exist yet: saving creates it
#   kt                    # bring Kertas to the front
#
# This script lives inside Kertas.app. Kertas's settings install it as
# /usr/local/bin/kt, a link to this file, so it always opens the Kertas.app
# it came from. It hands files to Kertas as kertas:// links, which reach a
# running Kertas or launch it, and work for files that don't exist yet.
set -eu

# Kertas.app is three levels up from Contents/Resources/kt.
script=$(realpath "$0")
app=$(dirname "$(dirname "$(dirname "$script")")")

# Percent-encodes $1 for a URL, byte by byte.
urlencode() {
    LC_ALL=C
    rest=$1
    out=
    while [ -n "$rest" ]; do
        c=${rest%"${rest#?}"}
        rest=${rest#?}
        case $c in
            [A-Za-z0-9._~/-]) out="$out$c" ;;
            *) out="$out$(printf '%%%02X' $(( $(printf '%d' "'$c") & 255 )))" ;;
        esac
    done
    printf '%s' "$out"
}

if [ $# -eq 0 ]; then
    exec "${KERTAS_OPEN:-open}" -a "$app" "kertas://activate"
fi

urls=
for path in "$@"; do
    case $path in
        /*) ;;
        *) path="$PWD/$path" ;;
    esac
    urls="$urls kertas://open?path=$(urlencode "$path")"
done
# The URLs have no spaces after encoding, so splitting on spaces is safe.
# shellcheck disable=SC2086
exec "${KERTAS_OPEN:-open}" -a "$app" $urls
